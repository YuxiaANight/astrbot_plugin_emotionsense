{
    "emotion_prompt": {
        "description": "情绪分析提示词",
        "type": "text",
        "default": "分析以下文本的情绪，只返回JSON格式：{\"emotion\": \"喜悦/悲伤/愤怒/焦虑/平静/困惑\", \"score\": 0.0-1.0}"
    },
    "negative_threshold": {
        "description": "负面情绪触发阈值",
        "type": "float",
        "default": 0.6
    },
    "care_interval": {
        "description": "主动关心间隔（单位：秒）",
        "type": "int",
        "default": 3600
    },
    "enable_care": {
        "description": "启用主动关心",
        "type": "bool",
        "default": true
    },
    "enable_llm_emotion": {
        "description": "启用 LLM 自身情绪",
        "type": "bool",
        "default": true
    },
    "no_reply_probability": {
        "description": "LLM 处于懒惰/生气时不回复的概率（0-1）",
        "type": "float",
        "default": 0.05
    },
    "slow_reply_delay": {
        "description": "LLM 处于伤心/烦躁时回复延迟的秒数",
        "type": "float",
        "default": 4.5
    }
}
